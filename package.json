{
  "name": "@yakisan/preflight",
  "version": "0.5.1",
  "description": "Catch App Review landmines before submission with a CLI-first risk engine for iOS release teams.",
  "author": "yunusemreyakisan",
  "license": "MIT",
  "homepage": "https://github.com/yunusemreyakisan/preflight#readme",
  "bugs": {
    "url": "https://github.com/yunusemreyakisan/preflight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunusemreyakisan/preflight.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "preflight": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts scan",
    "lint": "eslint .",
    "release:sync": "node --import tsx src/release/sync-github-releases.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "app-store",
    "app-review",
    "app-store-submission",
    "cli",
    "ci",
    "ios",
    "review-readiness",
    "privacy-manifest",
    "storekit",
    "react-native",
    "flutter",
    "fastlane",
    "release-engineering",
    "app-store-connect"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.22.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
